{
    // "Anatomy - Protein (present)": "This describes associations where the expression of a protein (gene) is found to be present in a specific anatomical entity.",
    "Drug - Drug": "This indicates synergistic interactions between different drugs.",
    "Protein - Protein": "This represents experimentally-verified physical interactions between proteins, including signaling, regulatory, metabolic-pathway, kinase-substrate, and protein complex interactions.",
    "Disease - Phenotype (positive)": "This denotes a positive association between a disease and a phenotype present.",
    "Biological process - Protein": "This links proteins (genes) to the biological processes they are involved in, or they are in interaction with, based on Gene Ontology terms.",
    "Cellular component - Protein": "This connects proteins (genes) to the cellular components where they are active, based on Gene Ontology terms.",
    "Disease - Protein": "This signifies curated associations between genes (proteins) and human diseases.",
    "Molecular function - Protein": "This associates proteins (genes) with their specific molecular functions, based on Gene Ontology terms.",
    "Drug - Phenotype": "This represents associations between drugs and their observed side effects (phenotypes).",
    "Biological process - Biological process": "This indicates hierarchical relationships between different biological process terms as defined by the Gene Ontology.",
    "Pathway - Protein": "This denotes interactions between specific biological pathways and proteins.",
    "Disease - Disease": "This describes parent-child relationships and other connections between disease terms, primarily derived from the MONDO Disease Ontology.",
    "Drug - Disease (contraindication)": "This signifies that a specific drug is not recommended or should not be used for treating a particular disease.",
    "Drug - Protein": "This represents interactions where a drug targets, or is metabolized/transported by, a specific protein (including targets, enzymes, carriers, and transporters).",
    // "Anatomy - Protein (absent)": "This describes associations where the expression of a protein (gene) is found to be absent in a specific anatomical entity.",
    "Phenotype - Phenotype": "This represents parent-child relationships between phenotype terms as defined in the Human Phenotype Ontology.",
    // "Anatomy - Anatomy": "This indicates hierarchical relationships between different anatomical entities as defined in the UBERON ontology.",
    "Molecular function - Molecular function": "This indicates hierarchical relationships between different molecular function terms as defined by the Gene Ontology.",
    "Drug - Disease (indication)": "This signifies that a specific drug is approved or used for treating a particular disease.",
    "Cellular component - Cellular component": "This indicates hierarchical relationships between different cellular component terms as defined by the Gene Ontology.",
    "Phenotype - Protein": "This denotes associations between specific proteins and observed phenotypic abnormalities.",
    "Drug - Disease (off-label use)": "This indicates that a specific drug is used for treating a particular disease for which it has not been officially approved.",
    "Pathway - Pathway": "This represents hierarchical relationships between different biological pathways as defined by the Reactome pathway database.",
    // "Exposure - Disease": "This describes associations between environmental exposures and diseases.",
    // "Exposure - Exposure": "This describes parent-child relationships between different environmental exposures.",
    // "Exposure - Biological process": "This links environmental exposures to the biological processes they affect.",
    // "Exposure - Protein": "This represents associations between environmental exposures and proteins.",
    "Disease - Phenotype (negative)": "This denotes a negative association between a disease and an observed phenotypic abnormality, meaning the phenotype is specifically noted as not being associated with the disease.",
    // "Exposure - Molecular function": "This links environmental exposures to the molecular functions they impact.",
    // "Exposure - Cellular component": "This connects environmental exposures to the cellular components they affect."
}